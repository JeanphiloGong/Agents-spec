%% Generic processing pipeline template
flowchart TD
    entry_receive_task_pipeline["PIPELINE_START\n(job/task trigger)"] --> usecase_parse_task_ingest["Stage 1: ingest"]
    usecase_parse_task_ingest --> branch_verify_ingest_failed{"Ingest failed?"}
    branch_verify_ingest_failed -->|yes| result_return_pipeline_failed["Failure branch\n(log + status update)"]
    branch_verify_ingest_failed -->|no| service_map_task_normalized["Stage 2: normalize/transform"]
    service_map_task_normalized --> branch_verify_retry_required{"Retry needed?"}
    branch_verify_retry_required -->|yes| service_map_task_normalized
    branch_verify_retry_required -->|no| repo_upsert_task_persist["Stage 3: persist/index"]
    repo_upsert_task_persist --> result_return_pipeline_done["Pipeline done"]

    event_emit_task_cancel["Cancel signal (optional)"] --> service_assemble_task_cleanup["Cleanup/rollback"]
    service_assemble_task_cleanup --> result_return_pipeline_failed

